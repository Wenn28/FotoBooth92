    { "id": "tinta", "name": "Tinta", "background": "#231F1C", "panelBorder": { "color": "#F1E9DD", "width": 3, "insets": [30] }, "textColor": "#FFFFFF" },
    { "id": "garis-ganda", "name": "Garis ganda", "background": "#FFFFFF", "panelBorder": { "color": "#231F1C", "width": 3, "insets": [20, 30] } }
